# Telegraph Protocol — TrustLens Configuration (Season II Mission 07)
# Copy this file to .env and configure EITHER rail below for live paid testnet calls.
# Never commit .env or expose real mainnet private keys!

# Rail A (Recommended quickstart): Telegraph Escrow API via Anjoman (free Sepolia testnet faucet)
TELEGRAPH_BACKEND_URL=https://backend.telegraphprotocol.com
ANJOMAN_API_KEY=

# Rail B (Direct permissionless x402 v2 EIP-3009 on Base Sepolia, 0 ETH gas)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AGENT_PRIVATE_KEY=

# Optional rail preference: escrow | x402 (defaults to escrow if ANJOMAN_API_KEY is set)
TELEGRAPH_PAYMENT_RAIL=

# Hard spending guardrails (USDC)
MAX_CHECK_BUDGET_USDC=0.05
MAX_SESSION_BUDGET_USDC=0.50

# Local server port
PORT=8787
